<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"           
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:views="clr-namespace:EcgViewer.Views"
      x:Class="EcgViewer.Views.EcgView"
      xmlns:vm="clr-namespace:EcgViewer.ViewModels"
      xmlns:converters="clr-namespace:EcgViewer.Converters" 
      xmlns:controls="clr-namespace:EcgViewer.Controls" >

    <UserControl.DataContext>
        <vm:EcgViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <Color x:Key="Accent">#96d1ff</Color>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:InverseBoolVisibilityConverter x:Key="InverseBoolVisibilityConverter" />
            <converters:BoolVisibilityConverter x:Key="BoolVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel Orientation="Vertical">
                <Label Content="Scan for BLE devices" FontSize="30"/>
                <StackPanel Orientation="Vertical"
                            Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolVisibilityConverter}}">
                    <Button>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Start Scanning"/>
                                <Setter Property="Command" Value="{Binding StartScanningCommand}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Content" Value="Stop Scanning"/>
                                        <Setter Property="Command" Value="{Binding StopScanningCommand}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <ListView 
                        x:Name="DevicesListView"
                        ItemsSource="{Binding DiscoveredDevices}"                           
                        Background="LightGray">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Path=Name}" Foreground="DarkSlateGray"
                                      Command="{Binding Path=DataContext.ConnectToDeviceCommand, Source={x:Reference DevicesListView}}" 
                                      CommandParameter="{Binding }"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Orientation="Vertical" Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibilityConverter}}">
                    <Label Content="{Binding ConnectedDevice, StringFormat='Connected to {0}'}" />

                    <Button Content="Disconnect" Background="OrangeRed"
                            Command="{Binding DisconnectCommand}"/>

                    <!--<Label Text="{Binding Value}" TextColor="Black"/>-->

                    <Label Content="{Binding HeartRate, StringFormat={}{0} bpm}" FontSize="20" HorizontalAlignment="Right"/>

                    <controls:ChartControl x:Name="ChartControl" Values="{Binding FilteredValues}" 
                                        GridColor="#e0816e" ShowGrid="True" GridAlignment="BothAxis"
                                        MinY="-2" MaxY="2" SizeMode="FitToHeight"
                                        MaxX="2400" MinX="0"
                                        ZeroPoint="0,0"
                                        TimeMode="Scrolling" StopTrackingOnDrag="False" StopTrackingOnZoom="False"
                                        ZoomMode="Both" MaxZoom="0.05"
                                        Height="300">
                        <controls:ChartControl.YAxis>
                            <controls:Axis Minimum="-6" Maximum="6" MinRange="2" ForceRangeLimit="False" SizeLimitMode="Fit"/>
                        </controls:ChartControl.YAxis>
                    </controls:ChartControl>

                    <ScrollBar x:Name="ScrollBar" Orientation="Horizontal" Scroll="ScrollBar_Scroll"/>

                    <ToggleButton x:Name="SkipToEndButton"
                                  Checked="SkipToEndButton_Clicked" Unchecked="ToggleButton_Unchecked" IsChecked="True"
                                  Padding="7" Width="30" Height="30" HorizontalAlignment="Right" Background="LightSteelBlue">
                        <Image Source="/Assets/skip_bright.png"/>
                    </ToggleButton>

                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding PollingRate}" Width="50"/>
                        <Button Content="Apply" Command="{Binding UpdatePollingRateCommand}"/>
                        <CheckBox Content="Enable Low-pass filter" IsChecked="{Binding LowPassFilterEnabled}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="FiltersListBox" ItemsSource="{Binding Filters}" SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Margin="5,2" IsChecked="{Binding IsEnabled}"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1">
                            <Button Content="Up" Click="FiltersUpButton_Click" Width="Auto"/>
                            <Button Content="Down" Click="FiltersDownButton_Click" Width="Auto"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
